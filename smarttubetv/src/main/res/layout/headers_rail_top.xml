<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube TV style: account + search buttons at the top of the sidebar rail (72dp wide) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/headers_rail_top"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="4dp">

    <ImageView
        android:id="@+id/rail_account"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="7dp"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="fitCenter"
        android:background="@drawable/rail_button_bg"
        android:src="@drawable/ic_rail_account"
        android:tint="@color/header_item_content"
        android:contentDescription="@string/settings_accounts" />

    <ImageView
        android:id="@+id/rail_search"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:padding="9dp"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="fitCenter"
        android:background="@drawable/rail_button_bg"
        android:src="@drawable/ic_rail_search"
        android:tint="@color/header_item_content"
        android:contentDescription="@string/settings_accounts" />
</LinearLayout>
