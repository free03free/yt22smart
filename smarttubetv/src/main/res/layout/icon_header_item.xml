<?xml version="1.0" encoding="utf-8"?>
<!--
    YouTube TV style sidebar item.
    paddingStart 20dp = (rail width 72dp - icon 32dp) / 2, so the icon is centered
    in the collapsed icons-only rail; the label sits right after it and is clipped
    away while the sidebar is collapsed.
-->
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:background="@drawable/header_item_pill">

    <ImageView
        android:id="@+id/header_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="3dp"
        android:duplicateParentState="true"
        android:tint="@color/header_item_content"
        android:contentDescription="@string/header_icon" />

    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
        android:id="@+id/header_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:duplicateParentState="true"
        android:textColor="@color/header_item_content"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"

        android:singleLine="true"
        android:maxWidth="170sp"
        android:marqueeRepeatLimit="marquee_forever"
        android:ellipsize="marquee"
        android:scrollHorizontally="true"

        style="@style/TextAppearance.Leanback.Header"/>
</androidx.leanback.widget.NonOverlappingLinearLayout>
